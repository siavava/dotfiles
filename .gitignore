# ignore everything
*
# */


# except for these files
!.gitignore
!.gitmessage
!.gitconfig
!README.md
!.bash_aliases
!.zshrc
!.condarc
!.vimrc
!.nuxtrc
!.chktexrc
!.bash_aliases
!.bashrc
!.bash_profile

# include gpg configs
!gpg.key

!.gnupg
!.gnupg/*.conf

# include common tex files
!latex-common
!latex-common/*

!config.fish
!alias.fish
!exports.fish
!prompt.fish

!fish.functions
!fish.functions/*

fish.functions/fisher.fish
fish.functions/*nvm*


!globals
!globals/*
globals/macros.tex

!common/*
!common.tex

# do not ignore .claude
!.claude

# ignore everything inside .claude
.claude/*

# track the global instructions
!.claude/CLAUDE.md

# track custom commands
!.claude/commands
!.claude/commands/*

# track custom skills
!.claude/skills
!.claude/skills/**/*
.claude/skills/find-skills
