[user]
	name = siavava
	email = amittaijoel@outlook.com
	signingkey = 35F03516A20DD95C

[commit]
	gpgsign = true
	template = ~/.gitmessage

[init]
	defaultBranch = main

[core]
  editor = vim
	pager = less -R
 	mergeoptions = --no-edit
	excludesfile = ~/globals/.gitignore

[gpg]
	program = gpg

[receive]
	advertisePushOptions = true

[alias]
	ac = commit -am
	alt = !git -c user.name=evilalt -c user.email=amittaijoel@gmail.com -c commit.gpgsign=false

[pull]
	rebase = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[push]
	autoSetupRemote = true
